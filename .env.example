# Copy this file to .env and replace every CHANGE_ME value before use.
POSTGRES_DB=advance_astro
POSTGRES_USER=advance_astro
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://advance_astro:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@postgres:5432/advance_astro
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_FERNET_KEY
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:3000
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EPHEMERIS_PATH=/app/data/ephemeris
# Keep blank: the Next.js same-origin /api proxy reaches the private API container.
NEXT_PUBLIC_API_BASE_URL=
# Optional local vision model. Example base URL: http://vision-llm:8000/v1
VISION_LLM_BASE_URL=
VISION_LLM_MODEL=
VISION_LLM_API_KEY=
# Optional follow-up worker and Twilio WhatsApp provider. Keep all blank until configured.
FEEDBACK_WORKER_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Local embeddings + Qdrant RAG. Never ingest unlicensed source material.
# Example: point this at your local OpenAI-compatible embedding server ending in /v1.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
KNOWLEDGE_ADMIN_SECRET=

