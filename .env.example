# Copy this file to .env and replace every CHANGE_ME value before use.
POSTGRES_DB=advance_astro
POSTGRES_USER=advance_astro
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://advance_astro:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@postgres:5432/advance_astro
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=private-assets
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_FERNET_KEY
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:3000
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EPHEMERIS_PATH=/app/data/ephemeris
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

